{
  "name": "ashcombe-signalling",
  "private": true,
  "version": "0.1.0",
  "description": "Educational browser-based British railway signalling simulator (Ashcombe Junction). Not a certified or operationally safe signalling system.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
}
